# @currentEnv=$APP_ENV
# @plugin(@varlock/keepass-plugin)
# @initKeePass(dbPath=$KP_DB_PATH, password=$KP_PASSWORD, useCli=forEnv(dev))

# ---

# @type=enum(dev, prod)
APP_ENV=dev

# @sensitive
KP_DB_PATH=

# @type=kdbxPassword @sensitive @internal
KP_PASSWORD=

# Server-only database env for the Next.js migration.

# @sensitive
DATABASE_URL=kp("atemoya-app/DATABASE_URL")

# Dedicated local integration-test database. Never configure this in Vercel.
# @sensitive
TEST_DATABASE_URL=kp("atemoya-app/TEST_DATABASE_URL")

# @sensitive
BETTER_AUTH_SECRET=kp("atemoya-app/BETTER_AUTH_SECRET")

# @sensitive
BETTER_AUTH_URL=kp("atemoya-app/BETTER_AUTH_URL")

# Independent versioned application-encryption keyrings.
# @sensitive
DATA_ENCRYPTION_KEYS=kp("atemoya-app/DATA_ENCRYPTION_KEYS")

# @sensitive=false
DATA_ENCRYPTION_ACTIVE_VERSION=1

# @sensitive
BLIND_INDEX_KEYS=kp("atemoya-app/BLIND_INDEX_KEYS")

# @sensitive=false
BLIND_INDEX_ACTIVE_VERSION=1

# @sensitive
RESEND_API_KEY=kp("atemoya-app/RESEND_API_KEY")

# @sensitive=false
AUTH_EMAIL_FROM=kp("atemoya-app/AUTH_EMAIL_FROM")

# Optional comma-separated LAN hosts trusted by Next and Better Auth during development.
# @sensitive=false
ALLOWED_DEV_ORIGINS=kp("atemoya-app/ALLOWED_DEV_ORIGINS")
