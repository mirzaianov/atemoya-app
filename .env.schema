# @currentEnv=$APP_ENV
# @plugin(@varlock/keepass-plugin)
# @initKeePass(dbPath=$KP_DB_PATH, password=$KP_PASSWORD, useCli=true)

# ---

# @type=enum(dev, prod) @sensitive=false
APP_ENV=dev

# Deploy-scoped application write barrier. Keep disabled outside maintenance windows.
# @type=enum(0, 1) @sensitive=false
MAINTENANCE_MODE=0

# @sensitive
KP_DB_PATH=

# @type=kdbxPassword @sensitive @internal
KP_PASSWORD=

# Server-only database env supplied by the active environment file.
# @sensitive @required
DATABASE_URL=

# Dedicated local integration-test database. Never configure this in Vercel.
# @sensitive @required=forEnv(dev)
TEST_DATABASE_URL=

# @sensitive @required
BETTER_AUTH_SECRET=

# @sensitive @required=forEnv(dev)
BETTER_AUTH_URL=

# Independent versioned application-encryption keyrings.
# @sensitive @required
DATA_ENCRYPTION_KEYS=

# @sensitive=false
DATA_ENCRYPTION_ACTIVE_VERSION=1

# @sensitive @required
BLIND_INDEX_KEYS=

# @sensitive=false
BLIND_INDEX_ACTIVE_VERSION=1

# @sensitive
RESEND_API_KEY=kp("atemoya-app/RESEND_API_KEY")

# @sensitive=false
AUTH_EMAIL_FROM=kp("atemoya-app/AUTH_EMAIL_FROM")

# Optional comma-separated LAN hosts trusted by Next and Better Auth during development.
# @sensitive=false @optional
ALLOWED_DEV_ORIGINS=
